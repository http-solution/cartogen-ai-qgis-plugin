# Commercial SaaS local/VPS configuration.
# Copy to .env and replace every CHANGE_ME value before deployment.

NODE_ENV=development
PUBLIC_BASE_URL=http://localhost:3000
WEBSITE_PORT=3000
DIRECTUS_PORT=8055
LITELLM_PORT=4000
NODE_VERSION=22

POSTGRES_USER=cartogen
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD
POSTGRES_DB=cartogen

DIRECTUS_IMAGE=directus/directus:11
DIRECTUS_KEY=CHANGE_ME_DIRECTUS_KEY_32_PLUS_CHARS
DIRECTUS_SECRET=CHANGE_ME_DIRECTUS_SECRET_64_PLUS_CHARS
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_LONG_ADMIN_PASSWORD
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_USER_REGISTRATION=true
DIRECTUS_REGISTER_ROLE=

LITELLM_IMAGE=ghcr.io/berriai/litellm:main-latest
LITELLM_MASTER_KEY=CHANGE_ME_LITELLM_MASTER_KEY
LITELLM_SALT_KEY=CHANGE_ME_LITELLM_SALT_KEY
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
