# --- LiteLLM gateway ---
# Any long random string; this is the admin key that can create/revoke virtual keys.
LITELLM_MASTER_KEY=sk-local-dev-master-key-change-me
# Postgres DB LiteLLM uses to persist virtual keys/budgets. See service/README.md.
DATABASE_URL=postgresql://litellm:litellm@localhost:5432/litellm

# At least one real provider key so the gateway has something to route to.
# (Not required just to test virtual-key generation, only for actual LLM calls.)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

# --- Website ---
PORT=3000
NODE_ENV=development
LITELLM_BASE_URL=http://localhost:4000

# Stripe test-mode keys (https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
# Set after creating a webhook in the Stripe dashboard (or via `stripe listen`).
# Leave blank + NODE_ENV=development to test the webhook locally without Stripe.
STRIPE_WEBHOOK_SECRET=
# Create one recurring Price in test mode and paste its ID here.
STRIPE_PRICE_ID=
