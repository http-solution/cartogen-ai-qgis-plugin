    {
     "what": "expected I is -0.0667",
     "step": 2,
     "path": "expected_i",
     "op": "approx",
     "value": -0.0667,
     "tol": 0.0001
    },
    {
     "what": "16 areas used",
     "step": 2,
     "path": "features",
     "op": "eq",
     "value": 16
    }
   ]
  },
  {
