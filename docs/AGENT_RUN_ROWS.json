    {
     "what": "one significant cluster",
     "step": 2,
     "path": "significant_clusters",
     "op": "eq",
     "value": 1
    },
    {
     "what": "707 cases in total",
     "step": 2,
     "path": "total_cases",
     "op": "eq",
     "value": 707
    },
    {
     "what": "a 5% cap gives 5 areas",
     "step": 3,
     "path": "clusters.0.areas",
     "op": "eq",
     "value": 5
    },
    {
     "what": "and 75 cases",
     "step": 3,
     "path": "clusters.0.cases",
     "op": "eq",
     "value": 75
