     "op": "approx",
     "value": 2.386,
     "tol": 0.001
    },
    {
     "what": "llr 34.289",
     "step": 2,
     "path": "clusters.0.llr",
     "op": "approx",
     "value": 34.289,
     "tol": 0.001
    },
    {
     "what": "radius 1414.214",
     "step": 2,
     "path": "clusters.0.radius",
     "op": "approx",
     "value": 1414.214,
     "tol": 0.001
    },
    {
     "what": "p 0.001",
     "step": 2,
