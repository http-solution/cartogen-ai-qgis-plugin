   "id": "H7-cluster-scan",
   "title": "Kulldorff scan: one cluster of 9 areas, 135 cases against 63.63 expected, relative risk 2.386, p 0.001; a model that is not built is refused",
   "covers_row": "C23-cluster-scan",
   "steps": [
    {
     "do": "load",
     "file": "smoke_districts_cases.geojson",
     "name": "smoke_districts_cases"
    },
    {
     "do": "tool",
     "name": "detect_spatial_clusters",
     "args": {
      "layer_name": "smoke_districts_cases",
      "case_field": "cases",
      "population_field": "population",
      "monte_carlo": 999,
      "seed": 1
     }
    },
    {
     "do": "tool",
     "name": "detect_spatial_clusters",
     "args": {
      "layer_name": "smoke_districts_cases",
      "case_field": "cases",
      "population_field": "population",
      "monte_carlo": 999,
      "seed": 1,
      "max_pop_fraction": 0.05,
      "output_layer_name": "capped"
     }
    },
    {
     "do": "tool",
     "name": "detect_spatial_clusters",
     "args": {
      "layer_name": "smoke_districts_cases",
      "case_field": "cases",
      "population_field": "population",
      "model": "bernoulli"
     }
    }
   ],
   "checks": [
    {
     "what": "success",
     "step": 2,
     "path": "success",
     "op": "true"
    },
