  {
   "id": "H4-geocode-protected-refused",
   "title": "A layer tagged SENSITIVE is refused by geocode_batch before any lookup (no network is used)",
   "covers_row": "C27-geocode-protected",
   "steps": [
    {
     "do": "load",
     "file": "smoke_clients.geojson",
     "name": "clients"
    },
    {
     "do": "tag",
     "layer": "clients",
     "level": "SENSITIVE"
    },
    {
     "do": "tool",
     "name": "geocode_batch",
     "args": {
      "location_names": [
       "Flat 3, 12 Example Street, Crater, Aden",
       "7 Sample Lane, Khormaksar, Aden"
      ],
      "source_layer": "clients"
     }
    }
   ],
   "checks": [
    {
     "what": "status is GEOCODING_REFUSED_PROTECTED",
     "step": 3,
     "path": "status",
     "op": "eq",
     "value": "GEOCODING_REFUSED_PROTECTED"
    },
    {
     "what": "the message names the layer",
     "step": 3,
     "path": "layers.0",
     "op": "eq",
     "value": "clients"
    },
    {
     "what": "the reply says refused",
     "step": 3,
     "path": "error",
     "op": "contains",
     "value": "refused"
    }
   ]
  },
