# Copy to .env in this directory (web-platform/phase-1/) and set every
# CHANGE_ME value before running `docker compose up`. Then run
# `npm run preflight` (node scripts/validate_env.js) -- it catches an unsafe
# POSTGRES_PASSWORD and unset required values before Docker gets involved.

# --- Postgres (shared by phase1-api, Directus, and LiteLLM) ---
POSTGRES_USER=cartogen
# phase1-api and phase1-worker connect using discrete PGHOST/PGUSER/PGPASSWORD
# vars (immune to this), but LiteLLM's own DATABASE_URL is assembled by
# docker-compose's ${VAR} substitution, which does NOT URL-encode. A password
# containing @ : / ? # would silently corrupt that URL. Generate this with
# something that only produces URL-safe characters, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM_DATABASE_PASSWORD

# --- Directus (user accounts, login) ---
DIRECTUS_KEY=CHANGE_ME_DIRECTUS_KEY_32_PLUS_CHARS
DIRECTUS_SECRET=CHANGE_ME_DIRECTUS_SECRET_64_PLUS_CHARS
DIRECTUS_ADMIN_EMAIL=admin@example.com
DIRECTUS_ADMIN_PASSWORD=CHANGE_ME_LONG_ADMIN_PASSWORD
DIRECTUS_PUBLIC_URL=http://localhost:8055
DIRECTUS_PORT=8055
# false until you're ready for self-service sign-up; true + a role id below
# lets /api/auth/register on the phase1-api create real Directus accounts.
DIRECTUS_USER_REGISTRATION=false
DIRECTUS_REGISTER_ROLE=

# --- phase1-api identity mode ---
# demo: single shared demo organization, no login required (local dev).
# directus: real per-user login via Directus, real organization membership.
PHASE1_IDENTITY_MODE=demo
# Legacy fallback org id for directus mode before any organization_members
# rows exist. Leave unset once you've created a real organization.
PHASE1_DIRECTUS_ORGANIZATION_ID=
# Off by default. Must be explicitly set to the literal string "true" to
# activate the fallback above at all -- otherwise a Directus user with no
# organization_members row simply gets no organization (401 error rather
# than being able to access PHASE1_DIRECTUS_ORGANIZATION_ID with no
# membership record). Never enable this on a shared/production deployment.
PHASE1_ALLOW_LEGACY_ORG_FALLBACK=false

# --- LiteLLM (billing/credit gateway) ---
LITELLM_PORT=4000
LITELLM_MASTER_KEY=CHANGE_ME_LITELLM_MASTER_KEY
# Dollars of underlying LLM spend allowed per organization per billing cycle.
LITELLM_PLAN_MAX_BUDGET_USD=5
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434

# --- Stripe (payment) ---
# Blank means billing routes report 503 "not configured" instead of erroring;
# the rest of the platform works fine without these set.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
PUBLIC_BASE_URL=http://localhost:4180

# --- AI planner ---
CARTOGEN_AI_PROVIDER=gemini
CARTOGEN_AI_PLANNER_MODEL=
